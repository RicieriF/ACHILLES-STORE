NODE_ENV=development
APP_ENV=development
# Required only to authorize pnpm clean:test-data in staging. Never set in production.
ALLOW_STAGING_TEST_DATA_CLEANUP=false
DATABASE_URL=postgres://achilles:local_development_only@localhost:5432/achilles_store
POSTGRES_DB=achilles_store
POSTGRES_USER=achilles
POSTGRES_PASSWORD=local_development_only
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace_with_a_long_random_value
COOKIE_SECRET=replace_with_a_long_random_value
NEXT_PUBLIC_COMMERCE_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:9000
STOREFRONT_BASE_URL=http://localhost:3000
REDIS_URL=
HOME_CATEGORY_MIN_PRODUCTS=1
BUSINESS_LOCALE=pt-BR
DISPLAY_TIMEZONE=America/Sao_Paulo
ALIBABA_PRODUCT_IMPORT=false
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_FREIGHT_QUOTE=false
ALIBABA_ORDER_CREATE=false
ALIBABA_ORDER_PAY=false
ALIBABA_TRACKING=false
CJ_ENABLED=false
CJ_PRODUCT_IMPORT=false
CJ_STOCK=false
CJ_SHIPPING=false
CJ_ORDER_CREATE=false
CJ_ORDER_PAY=false

# Guest checkout session lifetime; expired sessions keep customer/address but require new shipping quotes.
CHECKOUT_SESSION_TTL_MINUTES=30
CJ_TRACKING=false
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_BASE_URL=
EMAIL_ENABLED=false
RESEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
VIACEP_ENABLED=false
PREFER_BRAZIL_STOCK_WHEN_COMPETITIVE=false
STORE_NAME=ACHILLES STORE
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
DEFAULT_SHIPPING_POLICY=MANUAL_REVIEW
ORDER_APPROVAL_MODE=MANUAL
DEFAULT_TAX_MODE=MANUAL_QUOTE
ANALYTICS_PROVIDER=NONE
ANALYTICS_ID=
