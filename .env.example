NODE_ENV=development
APP_ENV=development
# Required only to authorize pnpm clean:test-data in staging. Never set in production.
ALLOW_STAGING_TEST_DATA_CLEANUP=false
DATABASE_URL=postgres://achilles:local_development_only@localhost:5432/achilles_store
POSTGRES_DB=achilles_store
POSTGRES_USER=achilles
POSTGRES_PASSWORD=local_development_only
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace_with_a_long_random_value
COOKIE_SECRET=replace_with_a_long_random_value
NEXT_PUBLIC_COMMERCE_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:9000
STOREFRONT_BASE_URL=http://localhost:3000
REDIS_URL=
HOME_CATEGORY_MIN_PRODUCTS=1
BUSINESS_LOCALE=pt-BR
DISPLAY_TIMEZONE=America/Sao_Paulo
ALIBABA_PRODUCT_IMPORT=false
ALIBABA_ENABLED=false
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_REFRESH_TOKEN=
ALIBABA_API_BASE_URL=https://eco.taobao.com/router/rest
ALIBABA_HEALTHCHECK_PRODUCT_ID=
ALIBABA_OAUTH_REDIRECT_URI=
ALIBABA_TEST_MODE=false
ALIBABA_FREIGHT_QUOTE=false
ALIBABA_ORDER_CREATE=false
ALIBABA_ORDER_PAY=false
ALIBABA_TRACKING=false
CJ_ENABLED=false
CJ_PRODUCT_IMPORT=false
CJ_STOCK=false
CJ_SHIPPING=false
CJ_ORDER_CREATE=false
CJ_ORDER_PAY=false

# Guest checkout session lifetime; expired sessions keep customer/address but require new shipping quotes.
CHECKOUT_SESSION_TTL_MINUTES=30
CJ_TRACKING=false
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_BASE_URL=https://developers.cjdropshipping.com
# Testes automatizados somente; bloqueado quando APP_ENV=production
CJ_TEST_MODE=false
EMAIL_ENABLED=false
RESEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
VIACEP_ENABLED=false
PREFER_BRAZIL_STOCK_WHEN_COMPETITIVE=false
STORE_NAME=ACHILLES STORE
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
DEFAULT_SHIPPING_POLICY=MANUAL_REVIEW
ORDER_APPROVAL_MODE=MANUAL
DEFAULT_TAX_MODE=MANUAL_QUOTE
ANALYTICS_PROVIDER=NONE
ANALYTICS_ID=
POSTHOG_ENABLED=false
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Production file storage. Configure all fields for AWS S3 or Cloudflare R2.
# Local Medusa storage is intentionally limited to development.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_PIX=false
MERCADO_PAGO_CARD=false
MERCADO_PAGO_BOLETO=false
MERCADO_PAGO_ENVIRONMENT=TEST
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
PAYMENT_TEST_PROVIDER_ENABLED=false
PAYMENT_TEST_WEBHOOK_SECRET=

# Supplier Order Gate: custos nunca assumem zero; percentuais são snapshots configuráveis.
SUPPLIER_MIN_MARGIN_PERCENT=10
SUPPLIER_PAYMENT_FEE_PERCENT=5
SUPPLIER_RISK_RESERVE_PERCENT=5
