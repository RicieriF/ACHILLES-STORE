{
  "name": "@achilles/commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "start:e2e": "medusa exec ./src/scripts/seed-e2e-admin.ts && medusa build && cd .medusa/server && medusa start",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate supplier_domain",
    "seed": "pnpm seed:dev",
    "seed:dev": "medusa exec ./src/scripts/seed.ts",
    "seed:e2e": "medusa exec ./src/scripts/seed-e2e-admin.ts",
    "seed:production": "medusa exec ./src/scripts/seed-production.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@achilles/config": "workspace:*",
    "@achilles/domain": "workspace:*",
    "@achilles/alibaba-connector": "workspace:*",
    "@achilles/cj-connector": "workspace:*",
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@tanstack/react-query": "5.64.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.11"
  }
}
