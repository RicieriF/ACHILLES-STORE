{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".medusa/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "ALIBABA_*",
        "CJ_*",
        "MERCADO_PAGO_*",
        "EMAIL_*",
        "RESEND_*",
        "PUBLIC_BASE_URL",
        "STOREFRONT_BASE_URL",
        "APP_ENV",
        "VIACEP_ENABLED",
        "PREFER_BRAZIL_STOCK_WHEN_COMPETITIVE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "ALIBABA_*",
        "CJ_*",
        "MERCADO_PAGO_*",
        "PAYMENT_TEST_*",
        "EMAIL_*",
        "RESEND_*",
        "PUBLIC_BASE_URL",
        "STOREFRONT_BASE_URL",
        "APP_ENV",
        "VIACEP_ENABLED",
        "PREFER_BRAZIL_STOCK_WHEN_COMPETITIVE"
      ]
    },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:integration": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
